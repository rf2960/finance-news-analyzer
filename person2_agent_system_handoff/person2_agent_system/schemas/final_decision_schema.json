{
  "title": "final_decision_schema",
  "type": "object",
  "required": [
    "ticker",
    "direction",
    "horizon",
    "confidence",
    "reasoning",
    "risks",
    "citations",
    "abstain",
    "validation_notes",
    "disagreement_signal",
    "disagreement_reason",
    "memory_notes",
    "market_context_notes"
  ],
  "properties": {
    "ticker": { "type": "string" },
    "direction": { "type": "string", "enum": ["bullish", "bearish", "neutral"] },
    "horizon": { "type": "string", "enum": ["5d", "20d"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "reasoning": { "type": "string" },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "abstain": { "type": "boolean" },
    "validation_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "disagreement_signal": { "type": "boolean" },
    "disagreement_reason": { "type": "string" },
    "memory_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "market_context_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
