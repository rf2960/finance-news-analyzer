# Copy this file to .env and fill in only the values you need.
# Leave OPENAI_API_KEY blank to run the default local heuristic mode.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Options: heuristic, langchain_openai
AGENT_BACKEND=heuristic

# Optional Bloomberg B-PIPE connection.
# Requires a licensed Bloomberg Terminal or enterprise B-PIPE setup.
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
