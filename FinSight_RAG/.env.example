# Copy this file to .env and fill in your values.
# The Streamlit app reads this via the sidebar's optional API-key field
# OR you can export these as shell environment variables.

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Leave blank to run in heuristic mode (no LLM calls, entirely local).
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Agent backend ─────────────────────────────────────────────────────────────
# Options:
#   heuristic       – keyword-based agents, no API calls (default)
#   langchain_openai – GPT-4o-mini via LangChain (requires OPENAI_API_KEY)
AGENT_BACKEND=heuristic
